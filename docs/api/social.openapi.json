          "entry_id",
          "movie_id",
          "title",
          "poster_path",
          "note",
          "comment_body",
          "suggestion_id"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "like",
              "comment",
              "follow",
              "response",
              "suggestion",
              "suggestion_reply",
              "suggestion_message"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "actor_id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "entry_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "movie_id": {
