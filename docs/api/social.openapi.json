              "Harassment",
              "Hate or threats",
              "Sexual content",
              "Violence",
              "Spam",
              "Privacy",
              "Other"
            ]
          },
          "details": {
            "type": "string",
            "maxLength": 1000,
            "default": ""
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ActivityPage": {
        "type": "object",
        "required": [
          "activity",
          "nextOffset"
