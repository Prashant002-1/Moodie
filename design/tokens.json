{
  "meta": {
    "name": "Moodie",
    "direction": "Gallery and screening room",
    "note": "Single source of truth. Run `npm run tokens` after editing. Generated files: src/styles/tokens.css, ios/Moodie/Design/Tokens.swift and the semantic colorsets in the iOS asset catalog. Android reads the same file when that client starts."
  },
  "color": {
    "light": {
      "canvas": "#FFFFFF",
      "surface": "#FFFFFF",
      "sunken": "#F5F5F3",
      "ink": "#0E0E0E",
      "inkSecondary": "#454545",
      "inkMuted": "#6E6E6E",
      "rule": "#E8E8E5",
      "ruleStrong": "#CFCFCB",
      "accent": "#2B3FD0",
      "accentPressed": "#2030AE",
      "onAccent": "#FFFFFF",
      "laurel": "#8F7437",
      "inverse": "#0E0E0E",
      "onInverse": "#FFFFFF",
      "error": "#B3261E",
      "success": "#1F6B4F"
    },
    "dark": {
      "canvas": "#0B0B0C",
      "surface": "#141415",
      "sunken": "#060607",
      "ink": "#F3F2EF",
      "inkSecondary": "#B9B8B4",
      "inkMuted": "#8B8A87",
      "rule": "#242425",
      "ruleStrong": "#3B3B3D",
      "accent": "#96A2FF",
      "accentPressed": "#7E8CF5",
      "onAccent": "#0B0B0C",
