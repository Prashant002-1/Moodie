{
  "meta": {
    "name": "Moodie",
    "direction": "The Programme",
    "note": "Single source of truth. Run `npm run tokens` after editing. Generated files: src/styles/tokens.css, ios/Moodie/Design/Tokens.swift and the semantic colorsets in the iOS asset catalog. Android reads the same file when that client starts."
  },
  "color": {
    "light": {
      "canvas": "#F4F1EA",
      "surface": "#FBF9F5",
      "sunken": "#EAE6DD",
      "ink": "#161D21",
      "inkSecondary": "#465056",
      "inkMuted": "#626B70",
      "rule": "#DAD6CD",
      "ruleStrong": "#B4B0A7",
      "accent": "#A63B2C",
      "accentPressed": "#8C2F22",
      "onAccent": "#FBF9F5",
      "laurel": "#8F7437",
      "inverse": "#161D21",
      "onInverse": "#F4F1EA",
      "error": "#9B3435",
      "success": "#2F6A5B"
    },
    "dark": {
      "canvas": "#0F1214",
      "surface": "#181C1F",
      "sunken": "#0A0C0E",
      "ink": "#EFEBE2",
      "inkSecondary": "#B4B8B6",
      "inkMuted": "#8C9294",
      "rule": "#2A2F33",
      "ruleStrong": "#454B50",
      "accent": "#E0705F",
      "accentPressed": "#C95B4B",
      "onAccent": "#0F1214",
      "laurel": "#C9A961",
      "inverse": "#EFEBE2",
      "onInverse": "#161D21",
      "error": "#E58A86",
      "success": "#7FBFA9"
    }
  },
  "feeling": {
    "note": "Keyed by the current seven-key scaffold. Hue is a secondary cue only: every feeling is always shown with its word.",
    "light": { "neutral": "#7C8589", "happy": "#C0862F", "sad": "#3C6585", "angry": "#963F37", "fearful": "#82506B", "disgusted": "#306E64", "surprised": "#726928" },
    "dark": { "neutral": "#A5ADB0", "happy": "#E0B25E", "sad": "#85AECB", "angry": "#ED9C90", "fearful": "#C5A0BF", "disgusted": "#8DC3B0", "surprised": "#C9BD7C" }
  },
  "font": {
    "display": "'Newsreader', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif",
    "sans": "'Instrument Sans Variable', 'Helvetica Neue', Helvetica, Arial, sans-serif",
    "mono": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace"
  },
  "type": {
    "note": "size / line height in px at the default text size. iOS maps each role to a Dynamic Type style instead of a fixed size.",
    "display": { "size": 56, "line": 60, "family": "display", "weight": 400, "ios": "largeTitle" },
    "title1": { "size": 40, "line": 44, "family": "display", "weight": 400, "ios": "title" },
    "title2": { "size": 30, "line": 36, "family": "display", "weight": 400, "ios": "title2" },
    "title3": { "size": 22, "line": 28, "family": "display", "weight": 400, "ios": "title3" },
    "body": { "size": 17, "line": 26, "family": "sans", "weight": 400, "ios": "body" },
    "callout": { "size": 15, "line": 22, "family": "sans", "weight": 400, "ios": "callout" },
    "caption": { "size": 13, "line": 18, "family": "sans", "weight": 400, "ios": "caption" },
    "label": { "size": 11, "line": 14, "family": "sans", "weight": 600, "ios": "caption2", "tracking": 0.08, "uppercase": true }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64, "9": 96 },
  "radius": { "poster": 2, "control": 6, "surface": 10, "pill": 999 },
  "motion": {
    "fast": 120,
    "base": 220,
    "slow": 420,
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)"
  }
}
