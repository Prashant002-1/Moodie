      "inverse": "#F3F2EF",
      "onInverse": "#0E0E0E",
      "error": "#F08C86",
      "success": "#7FBFA9"
    }
  },
  "feeling": {
    "note": "Keyed by the current seven-key scaffold. Hue is a secondary cue only: every feeling is always shown with its word.",
    "light": {
      "neutral": "#7C8589",
      "happy": "#C0862F",
      "sad": "#3C6585",
      "angry": "#963F37",
      "fearful": "#82506B",
      "disgusted": "#306E64",
      "surprised": "#726928"
    },
    "dark": {
      "neutral": "#A5ADB0",
      "happy": "#E0B25E",
      "sad": "#85AECB",
      "angry": "#ED9C90",
      "fearful": "#C5A0BF",
      "disgusted": "#8DC3B0",
      "surprised": "#C9BD7C"
    }
  },
  "font": {
    "display": "'Newsreader', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif",
    "sans": "'Inter Variable', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif",
    "mono": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace"
  },
  "type": {
    "note": "size / line height in px at the default text size; tracking in em. iOS maps each role to a Dynamic Type style instead of a fixed size. No role is uppercase or letter-spaced wide.",
    "display": {
      "size": 44,
      "line": 48,
      "family": "display",
      "weight": 400,
      "tracking": -0.02,
      "ios": "largeTitle"
    },
    "title1": {
      "size": 32,
      "line": 36,
      "family": "display",
      "weight": 400,
      "tracking": -0.015,
      "ios": "title"
    },
    "title2": {
      "size": 24,
      "line": 28,
      "family": "display",
      "weight": 400,
      "tracking": -0.01,
      "ios": "title2"
    },
    "title3": {
      "size": 19,
      "line": 24,
      "family": "display",
      "weight": 400,
      "tracking": -0.005,
      "ios": "title3"
    },
    "body": {
      "size": 16,
      "line": 24,
      "family": "sans",
      "weight": 400,
      "tracking": -0.011,
      "ios": "body"
    },
    "callout": {
      "size": 14,
      "line": 20,
      "family": "sans",
      "weight": 400,
      "tracking": -0.006,
      "ios": "callout"
    },
    "caption": {
      "size": 13,
      "line": 18,
      "family": "sans",
      "weight": 400,
      "tracking": 0,
      "ios": "caption"
    },
    "label": {
      "size": 12,
      "line": 16,
      "family": "sans",
      "weight": 500,
      "tracking": 0,
      "ios": "caption2"
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48,
    "8": 64,
