{
  "meta": {
    "name": "Moodie",
    "direction": "Screening Room",
    "note": "Single source of truth. Run `npm run tokens` after editing. Dark is the identity and the default; light is an option. Generated files: src/styles/tokens.css, ios/Moodie/Design/Tokens.swift and the semantic colorsets in the iOS asset catalog."
  },
  "color": {
    "light": {
      "canvas": "#FAF9F7",
      "band": "#FAF9F7",
      "surface": "#F2F0EC",
      "surfaceRaised": "#EAE7E2",
      "sunken": "#E3E0DA",
      "ink": "#161514",
      "inkSecondary": "#4A4844",
      "inkMuted": "#6F6C66",
      "rule": "#E3E0DA",
      "ruleStrong": "#CDC9C1",
      "accent": "#161514",
      "accentPressed": "#33312E",
      "onAccent": "#FAF9F7",
      "accentInk": "#161514",
      "laurel": "#6F6C66",
      "inverse": "#161514",
      "onInverse": "#FAF9F7",
      "error": "#B3261E",
      "success": "#1E7A4B"
    },
    "dark": {
      "canvas": "#111110",
      "band": "#111110",
      "surface": "#1A1918",
      "surfaceRaised": "#252422",
      "sunken": "#0A0A09",
      "ink": "#F2EFE9",
      "inkSecondary": "#BEBAB2",
      "inkMuted": "#8E8A83",
      "rule": "#2B2A28",
      "ruleStrong": "#3D3C39",
      "accent": "#F2EFE9",
      "accentPressed": "#D9D5CD",
      "onAccent": "#111110",
      "accentInk": "#F2EFE9",
      "laurel": "#8E8A83",
      "inverse": "#F2EFE9",
      "onInverse": "#111110",
      "error": "#F0958B",
      "success": "#7FC79B"
    }
  },
  "feeling": {
    "note": "Keyed by the current seven-key scaffold. Hue is a secondary cue only: every feeling is always shown with its word.",
    "light": {
      "neutral": "#7C8589",
      "happy": "#C0862F",
      "sad": "#3C6585",
      "angry": "#963F37",
      "fearful": "#82506B",
      "disgusted": "#306E64",
      "surprised": "#726928"
    },
    "dark": {
      "neutral": "#A5ADB0",
      "happy": "#E0B25E",
      "sad": "#85AECB",
      "angry": "#ED9C90",
      "fearful": "#C5A0BF",
      "disgusted": "#8DC3B0",
      "surprised": "#C9BD7C"
    }
  },
  "font": {
    "display": "'Fraunces Variable', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif",
    "sans": "'Inter Variable', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif",
    "mono": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace"
  },
  "type": {
    "note": "size / line height in px at the default text size; tracking in em. Serif roles carry titles and people's words; sans roles carry the interface. iOS maps each role to a Dynamic Type style.",
    "display": {
      "size": 44,
      "line": 48,
      "family": "display",
      "weight": 600,
      "tracking": -0.025,
      "ios": "largeTitle"
    },
    "title1": {
      "size": 34,
      "line": 38,
      "family": "display",
      "weight": 650,
      "tracking": -0.02,
      "ios": "title"
    },
    "title2": {
      "size": 24,
      "line": 28,
      "family": "display",
      "weight": 650,
      "tracking": -0.015,
      "ios": "title2"
    },
    "title3": {
      "size": 19,
      "line": 24,
      "family": "display",
      "weight": 650,
      "tracking": -0.01,
      "ios": "title3"
    },
    "quote": {
      "size": 20,
      "line": 30,
      "family": "display",
      "weight": 400,
      "tracking": -0.005,
      "ios": "title3",
      "italic": true
    },
    "reading": {
      "size": 17,
      "line": 27,
      "family": "display",
      "weight": 400,
      "tracking": 0,
      "ios": "body"
    },
    "body": {
      "size": 15,
      "line": 22,
      "family": "sans",
      "weight": 400,
      "tracking": -0.006,
      "ios": "body"
    },
    "callout": {
      "size": 14,
      "line": 20,
      "family": "sans",
      "weight": 400,
      "tracking": -0.004,
      "ios": "callout"
    },
    "caption": {
      "size": 13,
      "line": 18,
      "family": "sans",
      "weight": 400,
      "tracking": 0,
      "ios": "caption"
    },
    "label": {
      "size": 11,
      "line": 14,
      "family": "sans",
      "weight": 600,
      "tracking": 0.09,
      "uppercase": true,
      "ios": "caption2"
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48,
    "8": 64,
    "9": 96
  },
  "radius": { "poster": 8, "control": 10, "surface": 18, "pill": 999 },
  "motion": {
    "fast": 120,
    "base": 220,
    "slow": 420,
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "person": {
    "note": "Every person has a colour, chosen from their username. It fills their avatar and nothing else. The seven are one family: the same lightness and strength, different hues.",
    "dark": [
      "#D4A088",
      "#CBB078",
      "#9DBF98",
      "#84BFBD",
      "#92B4DC",
      "#B5A6DE",
      "#DA9DB2"
    ],
    "light": [
      "#9A5B40",
      "#7D6420",
      "#3F7A45",
      "#2A7773",
      "#3C6DA6",
      "#6A55B0",
      "#A4486A"
    ],
    "onDark": "#111110",
    "onLight": "#FFFFFF"
  }
}
