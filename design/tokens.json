  "feeling": {
    "note": "Keyed by the current seven-key scaffold. Hue is a secondary cue only: every feeling is always shown with its word.",
    "light": {
      "neutral": "#7C8589",
      "happy": "#C0862F",
      "sad": "#3C6585",
      "angry": "#963F37",
      "fearful": "#82506B",
      "disgusted": "#306E64",
      "surprised": "#726928"
    },
    "dark": {
      "neutral": "#A5ADB0",
      "happy": "#E0B25E",
