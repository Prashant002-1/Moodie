# Optional. Cached films remain available without a live catalog key.
TMDB_API_KEY=replace-with-your-tmdb-api-key

# Persistent local storage. Use an absolute path on a persistent volume in production.
# DATABASE_PATH=.data/emotionflix
# PORT=3001
# Production cookies require HTTPS. Set false ONLY for a local HTTP production smoke test.
# COOKIE_SECURE=false
# Set the exact trusted proxy hop count only when running behind your own proxy.
# TRUST_PROXY_HOPS=1
# Optional support destination shown in web Account information pages (https:// or mailto:).
VITE_SUPPORT_URL=

# Where links in notification emails lead: the public address of the web app.
# MOODIE_WEB_URL=https://your-moodie-address

# Hosted PostgreSQL is opt-in. The embedded local database stays the default.
# DATABASE_DRIVER=postgres
# DATABASE_URL=postgresql://moodie_app:password@host:5432/moodie
# DATABASE_SSL_MODE=verify-full
# DATABASE_CA_PATH=/app/certs/rds-global-bundle.pem
# DATABASE_POOL_SIZE=5
# Apply schema with the separate migration role before starting the API.
